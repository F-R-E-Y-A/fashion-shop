{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": true,
    "incremental": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*", "test/**/*", "prisma/**/*.ts", "prisma.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
