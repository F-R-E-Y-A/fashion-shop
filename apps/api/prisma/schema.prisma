// Cau hinh Prisma dung chung. Cac model duoc tach theo domain trong models/.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Prisma 7 khong con nhan `url` o day nua.
// Duong ket noi cho lenh migrate nam trong prisma.config.ts,
// con luc chay that thi PrismaClient nhan adapter trong prisma.service.ts.
datasource db {
  provider = "postgresql"
  schemas  = ["public", "staging", "reporting"]
}
