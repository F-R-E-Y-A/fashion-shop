// Ban 0.1: chi hai bang, vua du de module mau chay that tu bang du lieu toi giao dien.
// ERD day du hon 40 bang la viec cua HT-02, do Tai lam trong cung tuan 1.
// Muc dich cua tep nay la lam MAU cho hai ban chep theo, khong phai lam ERD.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

// Prisma 7 khong con nhan `url` o day nua.
// Duong ket noi cho lenh migrate nam trong prisma.config.ts,
// con luc chay that thi PrismaClient nhan adapter trong prisma.service.ts.
datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(220)
  description String?  @db.Text
  // Tien luu bang Decimal, khong dung Float. Float lam tron sai o tien te.
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categoryId  String   @map("category_id") @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([isActive, createdAt])
  @@map("products")
}
