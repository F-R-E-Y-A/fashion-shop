model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar
  slug      String   @unique @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
  @@schema("public")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar
  slug        String   @unique @db.VarChar
  description String?  @db.Text
  attributes  Json?    @db.JsonB
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variants       ProductVariant[]
  images         ProductImage[]
  reviews        Review[]
  wishlists      Wishlist[]
  recentlyViewed RecentlyViewed[]

  @@index([categoryId])
  @@map("products")
  @@schema("public")
}

model ProductVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  sku       String   @unique @db.VarChar
  size      String?  @db.VarChar
  color     String?  @db.VarChar
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product                Product                @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventory              Inventory?
  stockMovements         StockMovement[]
  inventoryReservations  InventoryReservation[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  replacementReturnItems ReturnItem[]           @relation("ReturnReplacementVariant")

  @@index([productId])
  @@map("product_variants")
  @@schema("public")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([productId, sortOrder])
  @@map("product_images")
  @@schema("public")
}

model HomepageSection {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionType   String   @map("section_type") @db.VarChar
  displayOrder  Int      @map("display_order")
  configuration Json?    @db.JsonB
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("homepage_sections")
  @@schema("public")
}

model SearchQueryLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  queryText   String   @map("query_text") @db.VarChar
  resultCount Int      @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("search_query_logs")
  @@schema("public")
}

model SearchConfiguration {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configurationKey   String   @unique @map("configuration_key") @db.VarChar
  configurationValue Json     @map("configuration_value") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("search_configurations")
  @@schema("public")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId])
  @@map("wishlists")
  @@schema("public")
}

model RecentlyViewed {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @map("viewed_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId])
  @@map("recently_viewed")
  @@schema("public")
}
