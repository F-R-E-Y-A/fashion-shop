enum FitFeedback {
  TOO_SMALL
  TRUE_TO_SIZE
  TOO_LARGE

  @@map("fit_feedback")
  @@schema("public")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
  @@schema("public")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELLED

  @@map("return_status")
  @@schema("public")
}

enum ReturnItemResolution {
  REFUND
  EXCHANGE

  @@map("return_item_resolution")
  @@schema("public")
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("refund_status")
  @@schema("public")
}

model Review {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  orderItemId      String       @unique @map("order_item_id") @db.Uuid
  rating           Int          @db.SmallInt
  content          String?      @db.Text
  fitFeedback      FitFeedback? @map("fit_feedback")
  moderationStatus ReviewStatus @default(PENDING) @map("moderation_status")
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviewer  User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  media     ReviewMedia[]

  @@index([productId, moderationStatus, createdAt])
  @@index([userId])
  @@map("reviews")
  @@schema("public")
}

model ReviewMedia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  url       String   @db.VarChar
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([reviewId, sortOrder])
  @@index([reviewId])
  @@map("review_media")
  @@schema("public")
}

model Return {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  orderId   String       @map("order_id") @db.Uuid
  status    ReturnStatus @default(REQUESTED)
  reason    String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  requester User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items     ReturnItem[]
  media     ReturnMedia[]
  refunds   Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([status, createdAt])
  @@map("returns")
  @@schema("public")
}

model ReturnItem {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnId             String               @map("return_id") @db.Uuid
  orderItemId          String               @map("order_item_id") @db.Uuid
  quantity             Int
  resolution           ReturnItemResolution
  replacementVariantId String?              @map("replacement_variant_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  returnRequest      Return          @relation(fields: [returnId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem          OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replacementVariant ProductVariant? @relation("ReturnReplacementVariant", fields: [replacementVariantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refundItems        RefundItem[]

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
  @@schema("public")
}

model ReturnMedia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnId  String   @map("return_id") @db.Uuid
  url       String   @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  returnRequest Return @relation(fields: [returnId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([returnId])
  @@map("return_media")
  @@schema("public")
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnId         String       @map("return_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  idempotencyKey   String       @unique @map("idempotency_key") @db.VarChar
  externalRefundId String?      @map("external_refund_id") @db.VarChar
  reason           String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  returnRequest Return       @relation(fields: [returnId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items         RefundItem[]

  @@index([returnId])
  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
  @@schema("public")
}

model RefundItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refundId     String   @map("refund_id") @db.Uuid
  returnItemId String   @map("return_item_id") @db.Uuid
  quantity     Int
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  refund     Refund     @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  returnItem ReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([refundId, returnItemId])
  @@index([returnItemId])
  @@map("refund_items")
  @@schema("public")
}
