enum AdministrativeAreaLevel {
  PROVINCE
  COMMUNE

  @@map("administrative_area_level")
  @@schema("public")
}

model AdministrativeArea {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String                  @unique @db.VarChar
  name      String                  @db.VarChar
  level     AdministrativeAreaLevel
  parentId  String?                 @map("parent_id") @db.Uuid
  isActive  Boolean                 @default(true) @map("is_active")
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent            AdministrativeArea?  @relation("AdministrativeAreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children          AdministrativeArea[] @relation("AdministrativeAreaHierarchy")
  addresses         Address[]
  shippingZoneAreas ShippingZoneArea[]

  @@map("administrative_areas")
  @@schema("public")
}

model Address {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  recipientName        String   @map("recipient_name") @db.VarChar
  phone                String   @db.VarChar
  administrativeAreaId String   @map("administrative_area_id") @db.Uuid
  detailAddress        String   @map("detail_address") @db.VarChar
  postalCode           String?  @map("postal_code") @db.VarChar
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("addresses")
  @@schema("public")
}

model ShippingZone {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar
  name      String   @db.VarChar
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  shippingZoneAreas ShippingZoneArea[]
  shippingRates     ShippingRate[]

  @@map("shipping_zones")
  @@schema("public")
}

model ShippingZoneArea {
  shippingZoneId       String   @map("shipping_zone_id") @db.Uuid
  administrativeAreaId String   @unique @map("administrative_area_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shippingZone       ShippingZone       @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([shippingZoneId, administrativeAreaId])
  @@map("shipping_zone_areas")
  @@schema("public")
}

model ShippingRate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shippingZoneId String   @map("shipping_zone_id") @db.Uuid
  minWeightGrams Int?     @map("min_weight_grams")
  maxWeightGrams Int?     @map("max_weight_grams")
  fee            Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  shippingZone ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orders       Order[]

  @@map("shipping_rates")
  @@schema("public")
}
