// Identity, shipping, after-sales, staging, and reporting models. Owner: TAI.
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  DISABLED

  @@map("user_status")
  @@schema("public")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  GUEST_RETURN_VERIFICATION

  @@map("otp_purpose")
  @@schema("public")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique @db.VarChar
  passwordHash    String     @map("password_hash") @db.VarChar
  status          UserStatus @default(PENDING_VERIFICATION)
  avatarUrl       String?    @map("avatar_url") @db.VarChar
  // Ho so ca nhan (PH4). Nullable cho tai khoan cu; phone KHONG unique: nguoi cung nha dung chung so,
  // va unique se bien PATCH /users/me thanh cong cu do so dien thoai nao da co tai khoan.
  fullName        String?    @map("full_name") @db.VarChar
  phone           String?    @db.VarChar
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  // Tang moi khi doi/dat lai mat khau; access JWT mang `ver` va AuthGuard so voi cot nay, nen moi
  // access token cu vo hieu ngay ma khong can danh sach den. Xem docs/features/auth/LOG.md (ADR-015).
  authVersion     Int        @default(0) @map("auth_version")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles          UserRole[]
  otpCodes           OtpCode[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  addresses          Address[]
  cart               Cart?
  orders             Order[]              @relation("OrderCustomer")
  orderStatusHistory OrderStatusHistory[] @relation("OrderStatusActor")
  voucherUsages      VoucherUsage[]
  reviews            Review[]
  reviewHelpfulVotes ReviewHelpfulVote[]
  reviewReports      ReviewReport[]
  returns            Return[]
  searchQueryLogs    SearchQueryLog[]
  wishlists          Wishlist[]
  recentlyViewed     RecentlyViewed[]
  notifications      Notification[]

  @@map("users")
  @@schema("public")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar
  name      String   @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles UserRole[]

  @@map("roles")
  @@schema("public")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("public")
}

model OtpCode {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @db.VarChar
  userId       String?    @map("user_id") @db.Uuid
  purpose      OtpPurpose
  codeHash     String     @map("code_hash") @db.VarChar
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime?  @map("consumed_at") @db.Timestamptz(3)
  attemptCount Int        @default(0) @map("attempt_count")
  sendCount    Int        @default(0) @map("send_count")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([email, purpose, consumedAt])
  @@map("otp_codes")
  @@schema("public")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replacedByToken RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replacementFor  RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("public")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar
  entityType  String   @map("entity_type") @db.VarChar
  entityId    String   @map("entity_id") @db.Uuid
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("audit_logs")
  @@schema("public")
}

enum AdministrativeAreaLevel {
  PROVINCE
  COMMUNE

  @@map("administrative_area_level")
  @@schema("public")
}

model AdministrativeArea {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String                  @unique @db.VarChar
  name      String                  @db.VarChar
  level     AdministrativeAreaLevel
  parentId  String?                 @map("parent_id") @db.Uuid
  isActive  Boolean                 @default(true) @map("is_active")
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent            AdministrativeArea?  @relation("AdministrativeAreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children          AdministrativeArea[] @relation("AdministrativeAreaHierarchy")
  addresses         Address[]
  shippingZoneAreas ShippingZoneArea[]

  @@map("administrative_areas")
  @@schema("public")
}

model Address {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  recipientName        String   @map("recipient_name") @db.VarChar
  phone                String   @db.VarChar
  administrativeAreaId String   @map("administrative_area_id") @db.Uuid
  detailAddress        String   @map("detail_address") @db.VarChar
  postalCode           String?  @map("postal_code") @db.VarChar
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // Moi truy van so dia chi loc theo user_id. Chi muc duy nhat mot-mac-dinh (partial, WHERE is_default) khong
  // phuc vu duoc truy van lay moi dia chi cua mot nguoi.
  @@index([userId])
  @@map("addresses")
  @@schema("public")
}

model ShippingZone {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar
  name      String   @db.VarChar
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  shippingZoneAreas ShippingZoneArea[]
  shippingRates     ShippingRate[]

  @@map("shipping_zones")
  @@schema("public")
}

model ShippingZoneArea {
  shippingZoneId       String   @map("shipping_zone_id") @db.Uuid
  administrativeAreaId String   @unique @map("administrative_area_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shippingZone       ShippingZone       @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  administrativeArea AdministrativeArea @relation(fields: [administrativeAreaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([shippingZoneId, administrativeAreaId])
  @@map("shipping_zone_areas")
  @@schema("public")
}

model ShippingRate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shippingZoneId String   @map("shipping_zone_id") @db.Uuid
  minWeightGrams Int?     @map("min_weight_grams")
  maxWeightGrams Int?     @map("max_weight_grams")
  fee            Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  shippingZone ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orders       Order[]

  @@map("shipping_rates")
  @@schema("public")
}

enum FitFeedback {
  TOO_SMALL
  TRUE_TO_SIZE
  TOO_LARGE

  @@map("fit_feedback")
  @@schema("public")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
  @@schema("public")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELLED

  @@map("return_status")
  @@schema("public")
}

enum ReturnItemResolution {
  REFUND
  EXCHANGE

  @@map("return_item_resolution")
  @@schema("public")
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("refund_status")
  @@schema("public")
}

model Review {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  orderItemId      String       @unique @map("order_item_id") @db.Uuid
  rating           Int          @db.SmallInt
  content          String?      @db.Text
  fitFeedback      FitFeedback? @map("fit_feedback")
  moderationStatus ReviewStatus @default(PENDING) @map("moderation_status")
  // Ban chup "Mau / Co" cua dong don luc viet: bien the doi ten hay ngung ban thi danh gia van ghi
  // dung thu khach da mua (ADR-054).
  variantLabel     String?      @map("variant_label") @db.VarChar(120)
  isAnonymous      Boolean      @default(false) @map("is_anonymous")
  // Tu nguyen, de nguoi xem doi chieu co voi dang nguoi; CHECK pham vi viet tay trong migration.
  heightCm         Int?         @map("height_cm") @db.SmallInt
  weightKg         Int?         @map("weight_kg") @db.SmallInt
  // Dem ghi san, doi cung giao dich voi bang phieu de sap xep "huu ich" khong phai gom nhom.
  helpfulCount     Int          @default(0) @map("helpful_count")
  reportCount      Int          @default(0) @map("report_count")
  editCount        Int          @default(0) @map("edit_count") @db.SmallInt
  editedAt         DateTime?    @map("edited_at") @db.Timestamptz(3)
  // Dau vet duyet va phan hoi cua shop. Cot *_by_id khong khai quan he: chi de tra cuu, khong join.
  moderationNote   String?      @map("moderation_note") @db.VarChar(500)
  moderatedAt      DateTime?    @map("moderated_at") @db.Timestamptz(3)
  moderatedById    String?      @map("moderated_by_id") @db.Uuid
  replyContent     String?      @map("reply_content") @db.Text
  repliedAt        DateTime?    @map("replied_at") @db.Timestamptz(3)
  repliedById      String?      @map("replied_by_id") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviewer     User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem    OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  media        ReviewMedia[]
  helpfulVotes ReviewHelpfulVote[]
  reports      ReviewReport[]

  @@index([productId, moderationStatus, createdAt])
  @@index([moderationStatus, createdAt])
  @@index([userId])
  @@map("reviews")
  @@schema("public")
}

model ReviewMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId     String   @map("review_id") @db.Uuid
  url          String   @db.VarChar
  // Khoa tren kho anh (public_id) de xoa anh cu khi danh gia doi anh; null voi anh nap tay. UNIQUE:
  // mot anh chi thuoc mot danh gia, xoa anh cua danh gia nay khong lam vo anh cua danh gia khac.
  storageKey   String?  @unique @map("storage_key") @db.VarChar(300)
  // Ban thu nho cho luoi anh 72 px (ADR-056): khong tai ban 1600 px chi de ve o nho. Null voi anh nap
  // tay, khi do web dung url.
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar
  sortOrder    Int      @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([reviewId, sortOrder])
  @@index([reviewId])
  @@map("review_media")
  @@schema("public")
}

enum MediaUploadStatus {
  PENDING
  DISCARDED
  DELETING

  @@map("media_upload_status")
  @@schema("public")
}

// So anh tren kho chua gan vao du lieu (ADR-056), thuoc phan he uploads. Cap phieu thi them PENDING;
// gan vao danh gia thi xoa dong trong cung giao dich; go anh khoi danh gia thi them DISCARDED. Worker
// nhan lo (DELETING, claimed_at la han thue), xoa tren kho roi xoa dong. Bang chi giu anh dang cho
// hoac cho xoa nen khong phinh. Khong khai quan he voi users: dong ngan han, khoa tren kho da chua
// userId.
model MediaUpload {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey String            @unique @map("storage_key") @db.VarChar(300)
  ownerId    String            @map("owner_id") @db.Uuid
  status     MediaUploadStatus @default(PENDING)
  attempts   Int               @default(0) @db.SmallInt
  claimedAt  DateTime?         @map("claimed_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("media_uploads")
  @@schema("public")
}

enum ReviewReportReason {
  SPAM
  OFFENSIVE
  IRRELEVANT
  PRIVACY
  OTHER

  @@map("review_report_reason")
  @@schema("public")
}

/// Moi nguoi mot phieu "huu ich" cho moi danh gia; khoa chinh doi chan bam lap.
model ReviewHelpfulVote {
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([reviewId, userId])
  @@index([userId])
  @@map("review_helpful_votes")
  @@schema("public")
}

/// Bao cao chi danh dau cho quan tri xem, khong tu an danh gia: tranh mot nhom bam bao cao de ha
/// danh gia that (ADR-054).
model ReviewReport {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId  String             @map("review_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  reason    ReviewReportReason
  note      String?            @db.VarChar(500)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([reviewId, userId])
  @@index([userId])
  @@map("review_reports")
  @@schema("public")
}

model Return {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  orderId   String       @map("order_id") @db.Uuid
  status    ReturnStatus @default(REQUESTED)
  reason    String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  requester User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items     ReturnItem[]
  media     ReturnMedia[]
  refunds   Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([status, createdAt])
  @@map("returns")
  @@schema("public")
}

model ReturnItem {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnId             String               @map("return_id") @db.Uuid
  orderItemId          String               @map("order_item_id") @db.Uuid
  quantity             Int
  resolution           ReturnItemResolution
  replacementVariantId String?              @map("replacement_variant_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  returnRequest      Return          @relation(fields: [returnId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem          OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replacementVariant ProductVariant? @relation("ReturnReplacementVariant", fields: [replacementVariantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refundItems        RefundItem[]

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
  @@schema("public")
}

model ReturnMedia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnId  String   @map("return_id") @db.Uuid
  url       String   @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  returnRequest Return @relation(fields: [returnId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([returnId])
  @@map("return_media")
  @@schema("public")
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnId         String       @map("return_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  idempotencyKey   String       @unique @map("idempotency_key") @db.VarChar
  externalRefundId String?      @map("external_refund_id") @db.VarChar
  reason           String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  returnRequest Return       @relation(fields: [returnId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items         RefundItem[]

  @@index([returnId])
  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
  @@schema("public")
}

model RefundItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refundId     String   @map("refund_id") @db.Uuid
  returnItemId String   @map("return_item_id") @db.Uuid
  quantity     Int
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  refund     Refund     @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  returnItem ReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([refundId, returnItemId])
  @@index([returnItemId])
  @@map("refund_items")
  @@schema("public")
}

enum CandidateStatus {
  PENDING_REVIEW
  DUPLICATE
  APPROVED
  REJECTED
  IMPORTED

  @@map("candidate_status")
  @@schema("staging")
}

model RawProductRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source          String   @db.VarChar
  sourceProductId String   @map("source_product_id") @db.VarChar
  sourceUrl       String   @map("source_url") @db.VarChar
  rawPayload      Json     @map("raw_payload") @db.JsonB
  collectedAt     DateTime @map("collected_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  normalizedCandidate NormalizedProductCandidate?

  @@unique([source, sourceProductId])
  @@map("raw_product_records")
  @@schema("staging")
}

model NormalizedProductCandidate {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawProductRecordId  String          @unique @map("raw_product_record_id") @db.Uuid
  name                String          @db.VarChar
  categoryName        String?         @map("category_name") @db.VarChar
  price               Decimal?        @db.Decimal(12, 2)
  attributes          Json?           @db.JsonB
  imageHash           String?         @db.VarChar
  normalizationStatus CandidateStatus @default(PENDING_REVIEW) @map("normalization_status")
  importedAt          DateTime?       @map("imported_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  rawProductRecord RawProductRecord @relation(fields: [rawProductRecordId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([normalizationStatus])
  @@index([importedAt])
  @@map("normalized_product_candidates")
  @@schema("staging")
}

model DailyRevenue {
  reportDate    DateTime @id @map("report_date") @db.Date
  orderCount    Int      @map("order_count")
  revenueAmount Decimal  @map("revenue_amount") @db.Decimal(12, 2)
  refreshedAt   DateTime @map("refreshed_at") @db.Timestamptz(3)

  @@map("daily_revenue")
  @@schema("reporting")
}

model TopSellingProduct {
  reportDate    DateTime @map("report_date") @db.Date
  productId     String   @map("product_id") @db.Uuid
  quantitySold  Int      @map("quantity_sold")
  revenueAmount Decimal  @map("revenue_amount") @db.Decimal(12, 2)
  refreshedAt   DateTime @map("refreshed_at") @db.Timestamptz(3)

  @@id([reportDate, productId])
  @@map("top_selling_products")
  @@schema("reporting")
}

model OrdersByStatus {
  reportDate  DateTime @map("report_date") @db.Date
  orderStatus String   @map("order_status") @db.VarChar
  orderCount  Int      @map("order_count")
  refreshedAt DateTime @map("refreshed_at") @db.Timestamptz(3)

  @@id([reportDate, orderStatus])
  @@map("orders_by_status")
  @@schema("reporting")
}

model LowStock {
  productVariantId  String   @id @map("product_variant_id") @db.Uuid
  availableQuantity Int      @map("available_quantity")
  refreshedAt       DateTime @map("refreshed_at") @db.Timestamptz(3)

  @@map("low_stock")
  @@schema("reporting")
}
