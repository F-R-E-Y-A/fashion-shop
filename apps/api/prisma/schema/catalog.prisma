// prisma/schema/catalog.prisma — bang cua Bao: danh muc va san pham (PH-01), sau nay them
// yeu thich, da xem, thanh toan, khuyen mai, bang ghi su kien. Ai so huu bang nao: docs/CONTRIBUTING.md.
// Hai bang duoi day la MAU de chep theo: @map / @@map noi camelCase trong ma voi snake_case trong CSDL,
// tien dung Decimal, moi bang co created_at va updated_at.

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(220)
  description String?  @db.Text
  // Tien luu bang Decimal, khong dung Float. Float lam tron sai o tien te.
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([isActive, createdAt])
  @@map("products")
}
