// Catalog and discovery models. Owner: BAO.
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar
  slug      String   @unique @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
  @@schema("public")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar
  slug        String   @unique @db.VarChar
  description String?  @db.Text
  attributes  Json?    @db.JsonB
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variants       ProductVariant[]
  images         ProductImage[]
  reviews        Review[]
  wishlists      Wishlist[]
  recentlyViewed RecentlyViewed[]

  @@index([categoryId])
  @@map("products")
  @@schema("public")
}

model ProductVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  sku       String   @unique @db.VarChar
  size      String?  @db.VarChar
  color     String?  @db.VarChar
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product                Product                @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventory              Inventory?
  stockMovements         StockMovement[]
  inventoryReservations  InventoryReservation[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  replacementReturnItems ReturnItem[]           @relation("ReturnReplacementVariant")

  @@index([productId])
  // Khai bu rang buoc UNIQUE NULLS NOT DISTINCT da viet tay trong migration ht02_final_baseline,
  // de db:drift khong doi xoa no. Prisma 7 chua mo ta duoc NULLS NOT DISTINCT. BAN TAM: PH-01 thay
  // bang khoa ngoai bat buoc toi colors, sizes (ADR-007, docs/features/products/erd.md).
  @@unique([productId, size, color], map: "product_variants_logical_combination_uq")
  @@map("product_variants")
  @@schema("public")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([productId, sortOrder])
  @@map("product_images")
  @@schema("public")
}

model HomepageSection {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionType   String   @map("section_type") @db.VarChar
  displayOrder  Int      @map("display_order")
  configuration Json?    @db.JsonB
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("homepage_sections")
  @@schema("public")
}

model SearchQueryLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  queryText   String   @map("query_text") @db.VarChar
  resultCount Int      @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("search_query_logs")
  @@schema("public")
}

model SearchConfiguration {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configurationKey   String   @unique @map("configuration_key") @db.VarChar
  configurationValue Json     @map("configuration_value") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("search_configurations")
  @@schema("public")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId])
  @@map("wishlists")
  @@schema("public")
}

model RecentlyViewed {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @map("viewed_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId])
  @@map("recently_viewed")
  @@schema("public")
}

enum VoucherStatus {
  INACTIVE
  ACTIVE

  @@map("voucher_status")
  @@schema("public")
}

enum PromotionStatus {
  INACTIVE
  ACTIVE

  @@map("promotion_status")
  @@schema("public")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("discount_type")
  @@schema("public")
}

enum PaymentMethod {
  COD
  ONLINE

  @@map("payment_method")
  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED

  @@map("payment_status")
  @@schema("public")
}

enum PaymentTransactionStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED

  @@map("payment_transaction_status")
  @@schema("public")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("job_status")
  @@schema("public")
}

model Voucher {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String        @unique @db.VarChar
  status            VoucherStatus @default(INACTIVE)
  discountType      DiscountType  @map("discount_type")
  discountValue     Decimal       @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?      @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderAmount    Decimal?      @map("min_order_amount") @db.Decimal(12, 2)
  usageLimit        Int?          @map("usage_limit")
  perUserLimit      Int?          @map("per_user_limit")
  startsAt          DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime?     @map("ends_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  usages VoucherUsage[]

  @@map("vouchers")
  @@schema("public")
}

model Promotion {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String          @db.VarChar
  discountType      DiscountType    @map("discount_type")
  discountValue     Decimal         @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?        @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderAmount    Decimal?        @map("min_order_amount") @db.Decimal(12, 2)
  conditions        Json?           @db.JsonB
  status            PromotionStatus @default(INACTIVE)
  startsAt          DateTime?       @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime?       @map("ends_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("promotions")
  @@schema("public")
}

model VoucherUsage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId      String   @map("voucher_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("voucher_usages")
  @@schema("public")
}

model Payment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@map("payments")
  @@schema("public")
}

model PaymentTransaction {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId             String                   @map("payment_id") @db.Uuid
  gateway               String                   @db.VarChar
  externalTransactionId String                   @map("external_transaction_id") @db.VarChar
  status                PaymentTransactionStatus
  payload               Json?                    @db.JsonB
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([gateway, externalTransactionId])
  @@index([paymentId, createdAt])
  @@map("payment_transactions")
  @@schema("public")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar
  aggregateType String    @map("aggregate_type") @db.VarChar
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json      @db.JsonB
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
  @@schema("public")
}

model Job {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType     String    @map("job_type") @db.VarChar
  status      JobStatus @default(PENDING)
  payload     Json?     @db.JsonB
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, scheduledAt])
  @@map("jobs")
  @@schema("public")
}
