// Catalog and discovery models. Owner: BAO.
// Mo hinh danh muc M2 (ADR-007, docs/features/products/erd.md): bien the la don vi ban, mau va co
// la bang tra cuu, moi san pham co it nhat mot bien the; san pham khong phan loai dung co FREE, mau mac-dinh.
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar
  slug      String   @unique @db.VarChar
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
  @@schema("public")
}

model Brand {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar
  slug      String   @unique @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
  @@schema("public")
}

model Color {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar
  name      String   @db.VarChar
  hex       String?  @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  variants ProductVariant[]
  images   ProductImage[]

  @@map("colors")
  @@schema("public")
}

model Size {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  variants ProductVariant[]

  @@map("sizes")
  @@schema("public")
}

model Product {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  brandId          String?  @map("brand_id") @db.Uuid
  name             String   @db.VarChar
  slug             String   @unique @db.VarChar
  description      String?  @db.Text
  material         String?  @db.VarChar
  careInstructions String?  @map("care_instructions") @db.Text
  attributes       Json?    @db.JsonB
  // Gia ban thap nhat trong cac bien the dang ban. Chi service products ghi, tinh lai trong cung
  // giao dich moi lan ghi bien the, de sap xep va loc theo gia khong phai gom nhom.
  priceFrom        Decimal  @map("price_from") @db.Decimal(12, 2)
  isActive         Boolean  @default(true) @map("is_active")
  isFeatured       Boolean  @default(false) @map("is_featured")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  variants       ProductVariant[]
  images         ProductImage[]
  reviews        Review[]
  wishlists      Wishlist[]
  recentlyViewed RecentlyViewed[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([isActive, priceFrom])
  @@map("products")
  @@schema("public")
}

model ProductVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  colorId   String   @map("color_id") @db.Uuid
  sizeId    String   @map("size_id") @db.Uuid
  sku       String   @unique @db.VarChar
  listPrice Decimal  @map("list_price") @db.Decimal(12, 2)
  salePrice Decimal? @map("sale_price") @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product                Product                @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  color                  Color                  @relation(fields: [colorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  size                   Size                   @relation(fields: [sizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventory              Inventory?
  stockMovements         StockMovement[]
  inventoryReservations  InventoryReservation[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  replacementReturnItems ReturnItem[]           @relation("ReturnReplacementVariant")

  // Mot san pham khong co hai bien the cung mau cung co. Cot deu bat buoc nen dung rang buoc thuong.
  @@unique([productId, colorId, sizeId], map: "product_variants_product_color_size_uq")
  @@index([colorId])
  @@index([sizeId])
  @@map("product_variants")
  @@schema("public")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  colorId   String?  @map("color_id") @db.Uuid
  url       String   @db.VarChar
  alt       String?  @db.VarChar
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([productId, sortOrder])
  @@map("product_images")
  @@schema("public")
}

model HomepageSection {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionType   String   @map("section_type") @db.VarChar
  displayOrder  Int      @map("display_order")
  configuration Json?    @db.JsonB
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("homepage_sections")
  @@schema("public")
}

model SearchQueryLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  queryText   String   @map("query_text") @db.VarChar
  resultCount Int      @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("search_query_logs")
  @@schema("public")
}

model SearchConfiguration {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configurationKey   String   @unique @map("configuration_key") @db.VarChar
  configurationValue Json     @map("configuration_value") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("search_configurations")
  @@schema("public")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId])
  @@map("wishlists")
  @@schema("public")
}

model RecentlyViewed {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @map("viewed_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId])
  @@map("recently_viewed")
  @@schema("public")
}

enum VoucherStatus {
  INACTIVE
  ACTIVE

  @@map("voucher_status")
  @@schema("public")
}

enum PromotionStatus {
  INACTIVE
  ACTIVE

  @@map("promotion_status")
  @@schema("public")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("discount_type")
  @@schema("public")
}

enum PaymentMethod {
  COD
  ONLINE

  @@map("payment_method")
  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED

  @@map("payment_status")
  @@schema("public")
}

enum PaymentTransactionStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED

  @@map("payment_transaction_status")
  @@schema("public")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("job_status")
  @@schema("public")
}

model Voucher {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String        @unique @db.VarChar
  status            VoucherStatus @default(INACTIVE)
  discountType      DiscountType  @map("discount_type")
  discountValue     Decimal       @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?      @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderAmount    Decimal?      @map("min_order_amount") @db.Decimal(12, 2)
  usageLimit        Int?          @map("usage_limit")
  perUserLimit      Int?          @map("per_user_limit")
  startsAt          DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime?     @map("ends_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  usages VoucherUsage[]

  @@map("vouchers")
  @@schema("public")
}

model Promotion {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String          @db.VarChar
  discountType      DiscountType    @map("discount_type")
  discountValue     Decimal         @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?        @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderAmount    Decimal?        @map("min_order_amount") @db.Decimal(12, 2)
  conditions        Json?           @db.JsonB
  status            PromotionStatus @default(INACTIVE)
  startsAt          DateTime?       @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime?       @map("ends_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("promotions")
  @@schema("public")
}

model VoucherUsage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId      String   @map("voucher_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("voucher_usages")
  @@schema("public")
}

model Payment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@map("payments")
  @@schema("public")
}

model PaymentTransaction {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId             String                   @map("payment_id") @db.Uuid
  gateway               String                   @db.VarChar
  externalTransactionId String                   @map("external_transaction_id") @db.VarChar
  status                PaymentTransactionStatus
  payload               Json?                    @db.JsonB
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([gateway, externalTransactionId])
  @@index([paymentId, createdAt])
  @@map("payment_transactions")
  @@schema("public")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar
  aggregateType String    @map("aggregate_type") @db.VarChar
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json      @db.JsonB
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
  @@schema("public")
}

model Job {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType     String    @map("job_type") @db.VarChar
  status      JobStatus @default(PENDING)
  payload     Json?     @db.JsonB
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, scheduledAt])
  @@map("jobs")
  @@schema("public")
}
