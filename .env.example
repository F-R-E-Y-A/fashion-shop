# Chep tep nay thanh .env roi sua neu can. Tep .env khong duoc dua len git.
# Them bien moi: khai o day VA o apps/api/src/infra/config/env.ts trong cung pull request.

# --- Co so du lieu (docker compose doc phan nay) ---
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion
POSTGRES_DB=fashion_shop
POSTGRES_PORT=5432

# --- May chu API doc phan nay, kiem luc khoi dong ---
DATABASE_URL=postgresql://fashion:fashion@localhost:5432/fashion_shop?schema=public
# CSDL RIENG cho kiem thu HTTP, bi xoa sach moi lan chay test. Tao bang: npm run db:test:prepare
DATABASE_URL_TEST=postgresql://fashion:fashion@localhost:5432/fashion_shop_test?schema=public
API_PORT=3001
NODE_ENV=development
# Cac goc web duoc goi API, cach nhau bang dau phay. Staging dien dia chi Vercel cua no.
CORS_ORIGINS=http://localhost:5174
# Secret nay chi la vi du local. Production phai dung secret rieng, dai va ngau nhien.
JWT_ACCESS_SECRET=replace-this-with-a-long-random-development-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
# Dung de tron OTP truoc khi bam (HMAC-SHA256). Secret nay chi la vi du local, dai it nhat 32 ky tu.
OTP_PEPPER=replace-this-with-a-long-random-development-pepper

# --- Email xac thuc (PH3.1). Local dung Mailpit tu docker-compose.yml, khong can tai khoan that ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER, SMTP_PASS de trong voi Mailpit. Production dien tai khoan SMTP that.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fashion Shop <no-reply@fashion-shop.local>"

# --- Gioi han toc do / chong do mat khau (PH3.4) ---
# Redis local do docker-compose.yml dung. REDIS_PORT la cong TREN MAY (mac dinh 6379); neu may da co
# Redis khac giu cong do thi doi, vd REDIS_PORT=6380 va REDIS_URL=redis://localhost:6380.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Tron email/userId truoc khi dung lam khoa Redis va khoa OTP. Secret nay chi la vi du local, >= 32 ky tu.
RATE_LIMIT_PEPPER=replace-this-with-a-long-random-development-pepper
# So proxy tin cay dung truoc API, dung de lay dung IP khach cho gioi han theo IP. De trong khi chay
# local (khach noi thang). BAT BUOC khai bao o staging/production: 0 = khong co proxy, 1 = sau mot proxy
# tin cay (vd load balancer cua nen tang). Dat sai thi moi nguoi dung bi tinh chung mot IP.
# TRUST_PROXY_HOPS=1

# --- Giao dien web doc phan nay (Vite chi doc bien bat dau bang VITE_) ---
VITE_API_URL=http://localhost:3001/api

# --- VNPAY: bo trong key thi preview duoc, tao thanh toan tra 503 (khong gia lap) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5174/thanh-toan/ket-qua
# Dang ky IPN HTTPS cong khai voi VNPAY: https://<api-host>/api/payments/vnpay/ipn

# --- MoMo sandbox: key do M4B cap, IPN HTTPS do payment:tunnel tao ---
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api
MOMO_RETURN_URL=http://localhost:5174/thanh-toan/ket-qua
MOMO_IPN_URL=
