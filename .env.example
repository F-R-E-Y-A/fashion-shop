# Chep tep nay thanh .env roi sua neu can. Tep .env khong duoc dua len git.

# --- Co so du lieu (docker compose doc phan nay) ---
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion
POSTGRES_DB=fashion_shop
POSTGRES_PORT=5432

# --- May chu API doc phan nay ---
DATABASE_URL=postgresql://fashion:fashion@localhost:5432/fashion_shop?schema=public
API_PORT=3001
NODE_ENV=development

# --- Giao dien web doc phan nay (Vite chi doc bien bat dau bang VITE_) ---
VITE_API_URL=http://localhost:3001/api
